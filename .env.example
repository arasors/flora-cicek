# Flora Çiçek — örnek ortam değişkenleri
# Bu dosyayı `.env.local` adıyla kopyalayın ve gerçek değerleri yalnızca orada tutun.
# `NEXT_PUBLIC_` ile başlayan değerler tarayıcı tarafından görülebilir; bu alanlara gizli anahtar yazmayın.

# Canlı sitenin protokol dahil ana adresi. Sonuna `/` eklemeyin.
# Canonical URL, Open Graph, sitemap, robots ve llms dosyalarında kullanılır.
NEXT_PUBLIC_SITE_URL=https://www.orneksite.com

# Arama motorlarının site sahipliği doğrulama tokenları.
# Yalnızca token değerini girin; komple HTML meta etiketini yapıştırmayın.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Analytics 4 ölçüm kimliği. Örnek biçim: G-XXXXXXXXXX
# GA4, Google Tag Manager içinden kurulacaksa çift ölçümü önlemek için bunu boş bırakın.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container kimliği. Örnek biçim: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Yandex Metrica sayaç numarası. Yalnızca rakam girin. Örnek: 12345678
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Session Replay / Webvisor için `true`; kapalı tutmak için `false`.
# Etkinleştirmeden önce aydınlatma metni ve çerez tercihlerinizle uyumunu kontrol edin.
NEXT_PUBLIC_YANDEX_WEBVISOR=false

# Meta Pixel kimliği. Yalnızca rakam girin. Örnek: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
